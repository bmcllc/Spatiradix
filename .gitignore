# ==============================================================================
# Mycelium Network — .gitignore
# ==============================================================================

# --- Build & Toolchains (Rust / Cargo / Android Soberano) ---------------------
/target/
**/target/
/dist/
/.android-sovereign/
/.cargo-home/
/.release-cargo/
/.release-rustup/
**/*.rs.bk
*.apk
*.aab
*.odex
*.vdex

# --- Runtime Local, Estado de Nó & Configurações Pessoais ---------------------
.mycelium/
/config/
/tmp/
opencode.json
xs
.env
.env.*
!.env.example

# --- Chaves, Certificados & Credenciais (NUNCA versionar!) --------------------
*.key
*.pem
*.p12
*.jks
*.keystore

# --- Editores, IDEs, SO & Logs Temporários ------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
**/.obsidian/
hs_err_pid*.log
*.log

# --- Python, Node & Caches de Ferramentas -------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.whl
node_modules/
.opencode/node_modules/
/graphify-out/
*.cdx.json

# --- Repositórios Embutidos, Backups & Snapshots Legados ----------------------
/S1/
/S1-BPF-source-update/
/S1-BPF-source-update old/
/apps/mycelium-s1-portal/
/vendor/
/ET-COSMIC-OLD/
.git-base-backup/
*.tar.gz
*.zip
*.patch
*.bin
